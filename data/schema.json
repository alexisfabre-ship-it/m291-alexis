{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://alexisfabre-ship-it.github.io/m291-alexis/data/schema.json",
  "title": "Projets AVisual",
  "description": "Structure de data.json : un tableau de projets d'Alexis Fabre.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "titre", "date", "annee", "reseau", "categorie", "commune", "description", "image", "lien"],
    "properties": {
      "id": { "type": "integer", "minimum": 1 },
      "titre": {
        "type": "string",
        "minLength": 3,
        "pattern": "^(?![Nn]ouveau)",
        "description": "Règle du brief : aucun titre ne commence par « Nouveau »."
      },
      "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Format AAAA-MM-JJ" },
      "annee": { "type": "integer", "minimum": 2020, "maximum": 2100 },
      "reseau": { "type": "string", "enum": ["Instagram", "LinkedIn"] },
      "categorie": {
        "type": "string",
        "enum": ["Identité visuelle", "Vidéo", "Affiche", "Packaging", "Photo", "Web", "Motion"]
      },
      "client": { "type": "string" },
      "commune": { "type": "string", "minLength": 2 },
      "description": { "type": "string", "minLength": 10, "maxLength": 200 },
      "outils": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
      "tags": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
      "misEnAvant": { "type": "boolean" },
      "image": { "type": "string", "pattern": "^images/.+\\.(svg|jpg|jpeg|png|webp)$" },
      "lien": { "type": "string", "format": "uri", "pattern": "^https://" }
    }
  }
}
